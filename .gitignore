# Run outputs — written by experiments/*/run.sh. Keep the directory itself
# tracked (via .gitkeep) so results/<exp>/ paths always resolve.
results/*
!results/.gitkeep

# Derived PPA characterization outputs — generated by ./setup.sh
# (stage script: data/ppa/generate_ppa.sh). The DRAM lookup CSVs, the
# per-run tool work tree, and every builder-generated architecture family
# are derived data: experiments read them at these exact paths, but they
# are never tracked.
data/ppa/cacti_ddr4_results.csv
data/ppa/dreamram_hbm2e_results.csv
data/ppa/lookup_work/
data/archs/lowered/buffer_sweep/
data/archs/lowered/geometry_sweep/
data/archs/lowered/geometry_sweep_host_congested/
data/archs/lowered/interconnect_sweep/

# Python
__pycache__/
*.pyc
.venv/
.ruff_cache/
*.egg-info/
